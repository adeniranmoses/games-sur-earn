# ─────────────────────────────────────────────────────────────────────────────
# REWARD PLATFORM PRODUCTION & ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase) ─────────────────
# Pooled connection string for application runtime queries (port 6543 / pgbouncer)
DATABASE_URL="postgresql://user:password@ep-your-db-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30"

# Direct unpooled connection string for Prisma migrations and schema push (port 5432)
DIRECT_URL="postgresql://user:password@ep-your-db.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=20"

# ─── 2. NEXTAUTH AUTHENTICATION ───────────────────────────────────────────────
# Generate a cryptographically secure 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_key_here_minimum_32_chars"
# Set to your live production domain when deploying (e.g. https://earnplatform.com)
NEXTAUTH_URL="http://localhost:3000"

# ─── 3. TRANSACTIONAL EMAIL SERVICE (Verification OTPs & Password Resets) ─────
# Option A: Resend API (Recommended - Free 3,000 emails/mo at https://resend.com)
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="FreeRewards <onboarding@resend.dev>"

# Option B: Gmail SMTP (No custom domain required - generate 16-character App Password at myaccount.google.com/apppasswords)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-google-app-password"

# ─── 4. FRAUD & VPN PROTECTION (ProxyCheck.io) ────────────────────────────────
# Register for free 1,000 queries/day at https://proxycheck.io
# Blocks VPNs, Proxies, Tor exit nodes, and datacenter bots on all sensitive routes
PROXYCHECK_API_KEY="your_proxycheck_api_key_here"

# ─── 5. BITLABS SURVEY OFFERWALL ──────────────────────────────────────────────
# Register publisher account at https://dashboard.bitlabs.ai
# Dashboard → Your App → Settings:
#   App Token: Used to generate the survey wall iframe URL
#   App Secret: Used to verify HMAC-SHA1 webhook signatures on postbacks
BITLABS_APP_TOKEN="your_bitlabs_app_token_here"
BITLABS_APP_SECRET="your_bitlabs_app_secret_here"
BITLABS_S2S_KEY="your_bitlabs_s2s_key_here"

# Postback URL to register in BitLabs Dashboard → Callbacks:
# https://yourdomain.com/api/webhooks/bitlabs?uid=[%USER:UID%]&val=[%VALUE:CURRENCY%]&tx_id=[%TX%]&type=[%ACTIVITY:TYPE%]&raw=[%VALUE:USD%]&hash=[Hash]

# ─── 6. CPX RESEARCH SURVEY OFFERWALL ─────────────────────────────────────────
# Register publisher account at https://publisher.cpx-research.com
# Dashboard → App Settings:
#   App ID: ID of your configured web app
#   App Key: Security key used for MD5 postback hash verification
CPX_APP_ID="your_cpx_app_id_here"
CPX_APP_KEY="your_cpx_app_key_here"

# Postback URL to register in CPX Research Dashboard → Postback Settings:
# https://yourdomain.com/api/webhooks/cpxresearch?user_id={user_id}&trans_id={trans_id}&status={status}&reward={amount_local}&hash={secure_hash}

# ─── 7. REWARDED VIDEO & INTERSTITIAL ADS NETWORK ─────────────────────────────
# Options: "sample" | "monetag" | "adsense" | "adsterra"
NEXT_PUBLIC_AD_NETWORK="sample"
# Toggle whether arcade games require an ad to play (true/false)
NEXT_PUBLIC_GATE_GAMES_WITH_ADS="true"

# Option A: Monetag (https://monetag.com)
# Create a Rewarded Interstitial or In-Page Push zone in Monetag Publisher Dashboard
NEXT_PUBLIC_MONETAG_ZONE_ID=""

# Option B: Google AdSense for Games / H5 Ads (https://adsense.google.com)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# Option C: Direct VAST Tag URL (AdinPlay / PropellerAds / Epom)
NEXT_PUBLIC_VAST_TAG_URL=""

# ─── 8. TESTING & LOCAL DEVELOPMENT ───────────────────────────────────────────
WEBHOOK_SECRET="mock_secret_test_123"
