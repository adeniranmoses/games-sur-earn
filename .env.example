# ─── DATABASE CONFIGURATION (PostgreSQL / Neon) ──────────────────────────────
# Pooled connection string for application runtime queries (port 6543 / pgbouncer)
DATABASE_URL="postgresql://user:password@ep-your-db-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30"

# Direct unpooled connection string for Prisma migrations and schema push (port 5432)
DIRECT_URL="postgresql://user:password@ep-your-db.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=20"

# ─── NEXTAUTH AUTHENTICATION ───────────────────────────────────────────────────
# Run `openssl rand -base64 32` to generate a secure secret
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# ─── RESEND TRANSACTIONAL EMAIL SERVICE ────────────────────────────────────────
# Get your API key at https://resend.com (free 3,000 emails/month)
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="RewardPlatform <onboarding@resend.dev>"

# ─── BITLABS SURVEY OFFERWALL ──────────────────────────────────────────────────
# Postback URL format to set in BitLabs Dashboard → Callbacks:
#   https://yoursite.com/api/webhooks/bitlabs?uid=[%USER:UID%]&val=[%VALUE:CURRENCY%]&tx_id=[%TX%]&type=[%ACTIVITY:TYPE%]&raw=[%VALUE:USD%]&hash=[Hash]
BITLABS_APP_TOKEN="your_bitlabs_app_token_here"
BITLABS_APP_SECRET="your_bitlabs_app_secret_here"
BITLABS_S2S_KEY="your_bitlabs_s2s_key_here"

# ─── CPX RESEARCH SURVEY OFFERWALL ─────────────────────────────────────────────
# Postback URL format to configure in CPX Research:
#   https://yoursite.com/api/webhooks/cpxresearch?user_id={user_id}&trans_id={trans_id}&status={status}&reward={amount_local}&hash={secure_hash}
CPX_APP_KEY="your_cpx_app_key_here"

# ─── MOCK TESTING / GENERIC WEBHOOK SECRET ─────────────────────────────────────
# Used by /api/webhooks/mock-offer for local development
WEBHOOK_SECRET="mock_secret_test_123"
